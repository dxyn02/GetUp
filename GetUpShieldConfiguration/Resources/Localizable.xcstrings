        "en" : {"stringUnit" : {"state" : "translated", "value" : "You can use the app again automatically when you leave the selected location or the scheduled time ends."}},
        "ko" : {"stringUnit" : {"state" : "translated", "value" : "설정한 위치에서 벗어나거나 시간이 끝나면 자동으로 다시 사용할 수 있어요."}}
