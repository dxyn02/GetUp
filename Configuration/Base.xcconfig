// 공통 도구체인 및 플랫폼 기준
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// 모든 타깃은 공통 prefix와 타깃별 suffix로 bundle identifier를 구성한다.
GETUP_BUNDLE_IDENTIFIER_PREFIX = com.dxyn02.GetUp
GETUP_APP_GROUP_IDENTIFIER = group.com.dxyn02.GetUp
GETUP_ICLOUD_CONTAINER_IDENTIFIER = iCloud.com.dxyn02.GetUp
// 명령줄에서만 채우는 T089 DEBUG 실기기 검증용 격리 설정이다.
// Release 빌드에서는 Info.plist 값이 있어도 코드가 무시한다.
GETUP_T089_LEDGER_NAMESPACE =
GETUP_T089_MONTHLY_BOUNDARY_DAY =
GETUP_COIN_PRODUCT_1_IDENTIFIER = com.dxyn02.GetUp.coin.1
GETUP_COIN_PRODUCT_3_IDENTIFIER = com.dxyn02.GetUp.coin.3
GETUP_COIN_PRODUCT_5_IDENTIFIER = com.dxyn02.GetUp.coin.5
PRODUCT_BUNDLE_IDENTIFIER = $(GETUP_BUNDLE_IDENTIFIER_PREFIX)$(GETUP_BUNDLE_IDENTIFIER_SUFFIX)
