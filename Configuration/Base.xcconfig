// 공통 도구체인 및 플랫폼 기준
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// 모든 타깃은 공통 prefix와 타깃별 suffix로 bundle identifier를 구성한다.
GETUP_BUNDLE_IDENTIFIER_PREFIX = com.getup.GetUp
GETUP_APP_GROUP_IDENTIFIER = group.com.getup.GetUp
PRODUCT_BUNDLE_IDENTIFIER = $(GETUP_BUNDLE_IDENTIFIER_PREFIX)$(GETUP_BUNDLE_IDENTIFIER_SUFFIX)
