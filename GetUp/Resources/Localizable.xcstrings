    },
    "%@부터 최소 15분 이후, 12시간 이내만 선택할 수 있어요" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a time at least 15 minutes and no more than 12 hours after %@"
