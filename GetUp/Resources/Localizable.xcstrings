      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ %3$@ %4$@ %5$@"
          }
        }
      }
    },
    "%@/%@" : {
      "comment" : "A label showing the number of characters in the current location name. The first argument is the current number of characters. The second argument is the maximum allowed number of characters.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
