            "value" : "%1$@에서 %2$@ 밖으로 나서면"
          }
        }
      }
    },
    "%@은 그대로 유지됐어요. 잠시 후 다시 시도해주세요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is unchanged. Please try again shortly."
