        }
      }
    },
    "%@에서 %@ 밖으로 나서면" : {
      "comment" : "A label that explains the distance the user needs to step outside from a saved place.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you move %2$@ away from %1$@"
